# Tempo Testnet Configuration
# Copy this file to .env and fill in your values

# Network settings (pre-filled for Tempo Testnet Moderato)
RPC_URL=https://rpc.moderato.tempo.xyz
CHAIN_ID=42431
EXPLORER_URL=https://explore.tempo.xyz

# ===========================================
# WALLET CONFIGURATION (TESTNET ONLY!)
# Never use mainnet private keys!
# ===========================================

# Player wallet - YOUR wallet that stakes tokens in battles
# Fund this with pathUSD from the Tempo faucet
PLAYER_WALLET=0x_YOUR_PRIVATE_KEY_HERE

# Trainer 1 wallet - Also acts as ESCROW (holds the battle pot)
# Fund with small amount for gas fees
TRAINER_1_NAME=Chad Blackstone
TRAINER_1_PRIVATE_KEY=0x_TRAINER_1_PRIVATE_KEY_HERE

# Trainer 2 (optional - addresses derived from private keys)
TRAINER_2_NAME=Priya Ventures
TRAINER_2_PRIVATE_KEY=0x_TRAINER_2_PRIVATE_KEY_HERE

# Trainer 3 (optional)
TRAINER_3_NAME=François McKinsey
TRAINER_3_PRIVATE_KEY=0x_TRAINER_3_PRIVATE_KEY_HERE
