# Tempo Testnet Configuration
# Copy this file to .env and fill in your values

# Network settings (these are pre-filled for Tempo Testnet Moderato)
RPC_URL=https://rpc.moderato.tempo.xyz
CHAIN_ID=42431
EXPLORER_URL=https://explore.tempo.xyz

# Trainer wallets (TESTNET ONLY - never use mainnet private keys!)
# Each trainer needs an address and private key
# Fund these wallets with testnet tokens before playing

TRAINER_1_NAME=Chad Blackstone
TRAINER_1_ADDRESS=0x...
TRAINER_1_PRIVATE_KEY=0x...

TRAINER_2_NAME=Priya Ventures
TRAINER_2_ADDRESS=0x...
TRAINER_2_PRIVATE_KEY=0x...

TRAINER_3_NAME=François McKinsey
TRAINER_3_ADDRESS=0x...
TRAINER_3_PRIVATE_KEY=0x...
